# Reality ASM configuration. Copy to .env for local runs; on Render, add these in the service's Environment tab.
# Never commit real keys.

# --- Web app (required in production)
SECRET_KEY=                      # long random string, e.g. `python -c "import secrets; print(secrets.token_hex(32))"`
DATABASE_PATH=/var/data/reality.db   # put it on a persistent disk; the default data/reality.db is fine locally
COOKIE_SECURE=true               # true behind HTTPS (Render), false for http://localhost
PUBLIC_BASE_URL=https://your-domain.example
CONTACT_EMAIL=support@plazmonix.ai

# --- Beta access (optional): comma-separated invite codes; leave empty for open sign-up
BETA_INVITE_CODES=
# Accounts (emails) that can open the beta admin page: sign-ups, activity and feedback
ADMIN_EMAILS=

# --- AI analyst (optional): nim | groq | xai, and the matching comma-separated key pool
LLM_PROVIDER=nim
NIM_API_KEYS=
GROQ_API_KEYS=
XAI_API_KEYS=
# Defaults: groq → llama-3.3-70b-versatile, nim → meta/llama-3.1-70b-instruct, xai → grok-3
# LLM_MODEL=
# LLM_BASE_URL=

# --- Google sign-in (optional). Authorised redirect URI: https://your-domain/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Password-reset email (optional). Without it, the reset page tells people to write to CONTACT_EMAIL.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- Limits (optional)
# SIMULATE_RATE_PER_S=25
# ASK_RATE_PER_MIN=12
# ENABLE_API_DOCS=false
# TOOL_TIMEOUT_S=20              # time limit for open-ended symbolic tools (seconds)
