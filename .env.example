# AI representative / AI analyst panel — any OpenAI-compatible provider below (keys are pooled and rotated)
# LLM_PROVIDER = nim | groq | xai
LLM_PROVIDER=groq
GROQ_API_KEYS=gsk_key1,gsk_key2
# NIM_API_KEYS=nvapi-key1,nvapi-key2
# XAI_API_KEYS=xai-key1
